<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <Compile Include="../Shared/WordDocumentFixture.cs" Link="Shared/WordDocumentFixture.cs" />
    <Compile Include="../Shared/DriveDocumentFixture.cs" Link="Shared/DriveDocumentFixture.cs" />
    <ProjectReference Include="../../src/HireZero.Host/HireZero.Host.csproj" />
    <!-- Build order only: the browser fixture and the Codex checks run FakeCodex.exe from its own output folder. -->
    <ProjectReference
      Include="../HireZero.FakeCodex/HireZero.FakeCodex.csproj"
      ReferenceOutputAssembly="false"
      SkipGetTargetFrameworkProperties="true"
    />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Fixtures/Pdf/*.pdf" LogicalName="PdfFixture.%(Filename).pdf" />
    <EmbeddedResource Include="Fixtures/BrowserPage.jpg" LogicalName="FictionalBrowserPage" />
  </ItemGroup>
  <PropertyGroup>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>
</Project>
